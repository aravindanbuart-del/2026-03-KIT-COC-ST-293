        plt.xticks(rotation=15, ha='right', fontname='Times New Roman', fontweight='bold')
        plt.ylim(0, 1.1)
        plt.savefig(os.path.join(RESULTS_DIR, f"{metric}_Comparison.png"), bbox_inches='tight')
        plt.close()
    
    setup_plot("Accuracy Trend", "Epochs", "Accuracy")
    plt.plot(range(1, len(resnet_history['train_acc'])+1), resnet_history['train_acc'], label='Train Acc', color=COLORS[0], lw=3)
    plt.plot(range(1, len(resnet_history['val_acc'])+1), resnet_history['val_acc'], label='Val Acc', color=COLORS[1], ls='--', lw=3)
    plt.legend(**FORMAT['legend'])
    plt.savefig(os.path.join(RESULTS_DIR, "ResNet18_Accuracy_Trend.png"), bbox_inches='tight')
    plt.close()
    
    setup_plot("Loss Trend", "Epochs", "Loss")
    plt.plot(range(1, len(resnet_history['train_loss'])+1), resnet_history['train_loss'], label='Train Loss', color=COLORS[2], lw=3)
