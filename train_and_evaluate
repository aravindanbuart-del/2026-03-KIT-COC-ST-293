# Improved Image Preprocessing
def pad_to_square(image, size=224):
    h, w = image.shape[:2]
    aspect = w / h
    if aspect > 1:
        new_w = size
        new_h = int(size / aspect)
    else:
        new_h = size
        new_w = int(size * aspect)
    
    resized = cv2.resize(image, (new_w, new_h), interpolation=cv2.INTER_AREA)
    
    pad_h = (size - new_h) // 2
    pad_w = (size - new_w) // 2
    
    padded = cv2.copyMakeBorder(resized, pad_h, size - new_h - pad_h, 
                                 pad_w, size - new_w - pad_w, 
                                 cv2.BORDER_CONSTANT, value=[255, 255, 255])
    return padded

# Custom Pad Transform for PIL
class RobustResize(object):
    def __init__(self, size=224):
        self.size = size
    def __call__(self, img):
        w, h = img.size
        aspect = w / h
        if aspect > 1:
            new_w = self.size
            new_h = int(self.size / aspect)
        else:
            new_h = self.size
            new_w = int(self.size * aspect)
        img = img.resize((new_w, new_h), Image.Resampling.LANCZOS)
        delta_w = self.size - new_w
        delta_h = self.size - new_h
        padding = (delta_w // 2, delta_h // 2, delta_w - (delta_w // 2), delta_h - (delta_h // 2))
        return transforms.functional.pad(img, padding, fill=255)

# Custom Dataset
class EnglishHandwrittenDataset(Dataset):
    def __init__(self, csv_file, img_dir, transform=None):
        self.data_frame = pd.read_csv(csv_file)
        self.img_dir = img_dir
        self.transform = transform
        
        # Build label mappings
        self.labels = sorted(self.data_frame['label'].unique())
        self.label_to_idx = {label: i for i, label in enumerate(self.labels)}
        self.idx_to_label = {i: label for label, i in self.label_to_idx.items()}
        
    def __len__(self):
        return len(self.data_frame)
    
    def __getitem__(self, idx):
        img_id = self.data_frame.iloc[idx, 0].replace('/', os.sep)
        img_full_path = os.path.join(self.img_dir, img_id)
        image = cv2.imread(img_full_path)
        if image is None: 
            image = np.full((224, 224, 3), 255, dtype=np.uint8)
        else:
            image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
            # STRONGER NOISE REMOVAL & CONTRAST
            image = cv2.bilateralFilter(image, 9, 75, 75)
            # Optional: CLAHE for better contrast if needed
            lab = cv2.cvtColor(image, cv2.COLOR_RGB2LAB)
            l, a, b = cv2.split(lab)
            clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8,8))
            cl = clahe.apply(l)
            limg = cv2.merge((cl,a,b))
            image = cv2.cvtColor(limg, cv2.COLOR_LAB2RGB)
        
        label = self.data_frame.iloc[idx, 1]
        label_idx = self.label_to_idx[label]
        
        if self.transform:
            image = Image.fromarray(image)
            image = self.transform(image)
            
        return image, label_idx

# Enhanced Transformations
data_transforms = {
    'train': transforms.Compose([
        RobustResize(224),
        transforms.RandomAffine(degrees=15, translate=(0.1, 0.1), scale=(0.85, 1.15)),
        transforms.RandomPerspective(distortion_scale=0.2, p=0.5),
        transforms.ColorJitter(brightness=0.2, contrast=0.2),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
        transforms.RandomErasing(p=0.2, scale=(0.02, 0.1), ratio=(0.3, 3.3), value=1)
    ]),
    'test': transforms.Compose([
        RobustResize(224),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
    ]),
}

def get_model(name, num_classes):
    if name == "ResNet-18":
        model = models.resnet18(pretrained=True)
        model.fc = nn.Sequential(nn.Dropout(0.3), nn.Linear(model.fc.in_features, num_classes))
    elif name == "VGG-16":
        model = models.vgg16(pretrained=True)
        model.classifier[6] = nn.Linear(model.classifier[6].in_features, num_classes)
    elif name == "AlexNet":
        model = models.alexnet(pretrained=True)
        model.classifier[6] = nn.Linear(model.classifier[6].in_features, num_classes)
    elif name == "MobileNet-V2":
        model = models.mobilenet_v2(pretrained=True)
        model.classifier[1] = nn.Linear(model.classifier[1].in_features, num_classes)
    elif name == "DenseNet-121":
        model = models.densenet121(pretrained=True)
        model.classifier = nn.Linear(model.classifier.in_features, num_classes)
    return model

def train_model(model, train_loader, val_loader, criterion, optimizer, device, num_epochs=3, scheduler=None):
    best_model_wts = copy.deepcopy(model.state_dict())
    best_acc = 0.0
    history = {'train_loss': [], 'val_loss': [], 'train_acc': [], 'val_acc': []}
    
    for epoch in range(num_epochs):
        print(f"Epoch {epoch+1}/{num_epochs}")
        for phase in ['train', 'val']:
            if phase == 'train':
                model.train()
                loader = train_loader
            else:
                model.eval()
                loader = val_loader
                
            running_loss = 0.0
            running_corrects = 0
            
            pbar = tqdm(loader, desc=f"{phase}")
            for inputs, labels in pbar:
                inputs, labels = inputs.to(device), labels.to(device)
                optimizer.zero_grad()
                with torch.set_grad_enabled(phase == 'train'):
                    outputs = model(inputs)
                    _, preds = torch.max(outputs, 1)
                    loss = criterion(outputs, labels)
                    if phase == 'train':
                        loss.backward()
                        optimizer.step()
                running_loss += loss.item() * inputs.size(0)
                running_corrects += torch.sum(preds == labels.data).item()
                
            epoch_loss = running_loss / len(loader.dataset)
            epoch_acc = running_corrects / len(loader.dataset)
            print(f"{phase} Loss: {epoch_loss:.4f} Acc: {epoch_acc:.4f}")
            
            if phase == 'train':
                history['train_loss'].append(epoch_loss)
                history['train_acc'].append(epoch_acc)
                if scheduler:
                    scheduler.step()
                    # Print current LR for monitoring
                    if phase == 'train':
                        current_lr = optimizer.param_groups[0]['lr']
                        pbar.set_postfix({"LR": f"{current_lr:.2e}"})
            else:
                history['val_loss'].append(epoch_loss)
                history['val_acc'].append(epoch_acc)
                if epoch_acc > best_acc:
                    best_acc = epoch_acc
                    best_model_wts = copy.deepcopy(model.state_dict())
                    
    model.load_state_dict(best_model_wts)
    return model, history

def evaluate_model(model, test_loader, device):
    model.eval()
    all_preds = []
    all_labels = []
    all_scores = []
    with torch.no_grad():
        for inputs, labels in test_loader:
            inputs = inputs.to(device)
            outputs = model(inputs)
            scores = torch.softmax(outputs, dim=1)
            _, preds = torch.max(outputs, 1)
            all_preds.extend(preds.cpu().numpy())
            all_labels.extend(labels.numpy())
            all_scores.extend(scores.cpu().numpy())
    return np.array(all_labels), np.array(all_preds), np.array(all_scores)

def main():
    dataset = EnglishHandwrittenDataset(CSV_PATH, IMG_DIR, transform=data_transforms['train'])
    num_classes = len(dataset.labels)
    indices = list(range(len(dataset)))
    train_indices, test_indices = train_test_split(indices, test_size=0.2, random_state=42, stratify=dataset.data_frame['label'])
    train_set = Subset(dataset, train_indices)
    test_set = Subset(dataset, test_indices)
    test_set.dataset.transform = data_transforms['test']
    train_loader = DataLoader(train_set, batch_size=32, shuffle=True)
    test_loader = DataLoader(test_set, batch_size=32, shuffle=False)
    
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Using device: {device}")
    
    model_names = ["ResNet-18", "VGG-16", "AlexNet", "MobileNet-V2", "DenseNet-121"]
    results_list = []
    roc_data = {}
    pr_data = {}
    resnet_history = None
    resnet_y_true, resnet_y_pred, resnet_y_scores = None, None, None

    for name in model_names:
        print(f"--- Processing {name} ---")
        model = get_model(name, num_classes).to(device)
        
        # LABEL SMOOTHING FOR BETTER PERFORMANCE ON SIMILAR CLASSES
        criterion = nn.CrossEntropyLoss(label_smoothing=0.1)
        
        # FINE-TUNED LEARNING PARAMETERS
        optimizer = optim.AdamW(model.parameters(), lr=1e-4, weight_decay=5e-2)
        # Cosine Annealing with Warmup-like behavior
        scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=15, eta_min=1e-6)
        
        # INCREASED EPOCHS FOR STABLE PERFORMANCE AS REQUESTED
        num_run_epochs = 25
        model, history = train_model(model, train_loader, test_loader, criterion, optimizer, device, num_epochs=num_run_epochs, scheduler=scheduler)
        
        y_true, y_pred, y_scores = evaluate_model(model, test_loader, device)
        
        roc_data[name] = (y_true, y_scores)
        pr_data[name] = (y_true, y_scores)
        
        acc = accuracy_score(y_true, y_pred)
        pre = precision_score(y_true, y_pred, average='weighted')
        rec = recall_score(y_true, y_pred, average='weighted')
        f1 = f1_score(y_true, y_pred, average='weighted')
        
        results_list.append({
            'Model': name, 'Accuracy': acc, 'Precision': pre, 'Recall': rec, 'F1-Score': f1
        })
        
        if name == "ResNet-18":
            resnet_history = history
            resnet_y_true, resnet_y_pred, resnet_y_scores = y_true, y_pred, y_scores
            
        del model
        torch.cuda.empty_cache()

    df_results = pd.DataFrame(results_list)
    df_results.to_csv(os.path.join(RESULTS_DIR, "metrics_comparison.csv"), index=False)
    
    # Graphs
    for metric in ['Accuracy', 'Precision', 'Recall', 'F1-Score']:
